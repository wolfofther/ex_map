# 이 파일을 복사해 .env 로 저장한 뒤 실제 값을 채워 넣으십시오.
# .env 는 절대 깃허브에 커밋하지 마십시오. (.gitignore에 이미 포함됨)

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급
# "Maps JavaScript API" 를 반드시 활성화해야 합니다.
VITE_GOOGLE_MAPS_API_KEY=여기에_구글맵_API_키_입력

# Supabase 프로젝트 설정 > API 에서 확인
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_supabase_anon_key_입력
